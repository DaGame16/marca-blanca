<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.marcablanca.platform</groupId>
        <artifactId>marca-blanca-backend</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>bootstrap</artifactId>
    <packaging>jar</packaging>

    <!-- NUEVO: valores por defecto para el plugin de Liquibase de cliente y control -->
    <properties>
        <liquibase.cliente.url>jdbc:postgresql://localhost:5432/db_plantilla_maestra</liquibase.cliente.url>
        <liquibase.cliente.username>guajiranet_owner</liquibase.cliente.username>
        <liquibase.cliente.password>guajiranet_owner</liquibase.cliente.password>

        <liquibase.control.url>jdbc:postgresql://localhost:5432/db_portal_guajiranet_control</liquibase.control.url>
        <liquibase.control.username>guajiranet_owner</liquibase.control.username>
        <liquibase.control.password>guajiranet_owner</liquibase.control.password>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.marcablanca.platform</groupId>
            <artifactId>shared-kernel</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.marcablanca.platform</groupId>
            <artifactId>empresas-domain</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.marcablanca.platform</groupId>
            <artifactId>empresas-application</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.marcablanca.platform</groupId>
            <artifactId>empresas-infrastructure</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.marcablanca.platform</groupId>
            <artifactId>modulos-empresa-domain</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.marcablanca.platform</groupId>
            <artifactId>modulos-empresa-application</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.marcablanca.platform</groupId>
            <artifactId>modulos-empresa-infrastructure</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.marcablanca.platform</groupId>
            <artifactId>usuarios-domain</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.marcablanca.platform</groupId>
            <artifactId>usuarios-application</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.marcablanca.platform</groupId>
            <artifactId>usuarios-infrastructure</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.marcablanca.platform</groupId>
            <artifactId>autenticacion-application</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.marcablanca.platform</groupId>
            <artifactId>autenticacion-infrastructure</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.marcablanca.platform</groupId>
            <artifactId>identidad-visual-domain</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.marcablanca.platform</groupId>
            <artifactId>identidad-visual-application</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.marcablanca.platform</groupId>
            <artifactId>identidad-visual-infrastructure</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.marcablanca.platform</groupId>
            <artifactId>omnicanal-domain</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.marcablanca.platform</groupId>
            <artifactId>omnicanal-application</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.marcablanca.platform</groupId>
            <artifactId>omnicanal-infrastructure</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.liquibase</groupId>
            <artifactId>liquibase-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-liquibase</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-docker-compose</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- NUEVO: ArchUnit protege las fronteras de la arquitectura hexagonal
             (domain/application/infrastructure y el aislamiento entre
             usuarios y omnicanal) con tests automaticos en cada build. -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <version>1.3.2</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>marca-blanca-backend</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>

            <!-- NUEVO: aplica los changelogs a mano.
                 No corre en el build normal ni en el arranque de la app (el changelog de
                 "control" sí corre solo al arrancar la app, vía Spring Boot Liquibase).

                 Uso:
                   mvn liquibase:update@aplicar-cliente   -> changelog de cliente (por defecto)
                   mvn liquibase:update@aplicar-control   -> changelog de control (para CI/pruebas) -->
            <plugin>
                <groupId>org.liquibase</groupId>
                <artifactId>liquibase-maven-plugin</artifactId>
                <configuration>
                    <searchPath>${project.basedir}/src/main/resources</searchPath>
                    <driver>org.postgresql.Driver</driver>
                </configuration>
                <executions>
                    <execution>
                        <id>aplicar-cliente</id>
                        <configuration>
                            <changeLogFile>db/changelog/cliente/db.changelog-master.yaml</changeLogFile>
                            <url>${liquibase.cliente.url}</url>
                            <username>${liquibase.cliente.username}</username>
                            <password>${liquibase.cliente.password}</password>
                        </configuration>
                    </execution>
                    <execution>
                        <id>aplicar-control</id>
                        <configuration>
                            <changeLogFile>db/changelog/control/db.changelog-master.yaml</changeLogFile>
                            <url>${liquibase.control.url}</url>
                            <username>${liquibase.control.username}</username>
                            <password>${liquibase.control.password}</password>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
